# Puerto HTTP del servidor
PORT=8787

# Ruta del archivo SQLite (se persiste en ./data vía docker-compose)
DATABASE_PATH=./data/manga-spawn.sqlite

# Token de acceso de Expo (Enhanced Push Security). Opcional en desarrollo.
EXPO_ACCESS_TOKEN=

# Clave para los endpoints /v1/admin/*
ADMIN_API_KEY=cambia-esto

# Cada cuántos minutos se revisan capítulos nuevos
CHECK_INTERVAL_MINUTES=30

# Cada cuántos minutos se revisan los recibos de push
RECEIPT_INTERVAL_MINUTES=15

# CORS: origen permitido (usa * para desarrollo)
CORS_ORIGIN=*
