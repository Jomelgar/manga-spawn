# Activa las notificaciones locales en Expo Go (Android) SOLO si aplicaste el patch:
#   npm run expo-go:notifications:on
EXPO_PUBLIC_EXPO_GO_NOTIFICATIONS=0

# Proxy opcional para la API de MangaDex en web (CORS):
# EXPO_PUBLIC_MANGADEX_PROXY=https://tu-proxy.example.com

# URL de tu servidor de notificaciones (ver ./server). Si está vacío,
# se usan solo las notificaciones locales.
# EXPO_PUBLIC_NOTIFICATIONS_API_URL=http://192.168.1.10:8787
